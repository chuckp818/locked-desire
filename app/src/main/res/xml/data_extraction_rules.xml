<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 und neuer: Nichts geht in die Cloud-Sicherung. Die direkte Übertragung auf ein neues Gerät
    (Kabel/Nähe, vom Nutzer gestartet) darf Datenbank, Dateien und Einstellungen mitnehmen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
