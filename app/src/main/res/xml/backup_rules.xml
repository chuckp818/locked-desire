<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 und älter: keine Daten in die Cloud-Sicherung (privat, nur lokal). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
